# 应用对外端口
APP_PORT=8082

# 可选：通过环境变量预置数据库连接（首次打开页面填写会更直观，且会覆盖以下环境变量）
# 如需使用内嵌 MySQL 服务，请取消 docker-compose.yml 中 mysql 服务的注释后填写
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dnsmgr
DB_PASSWORD=dnsmgr123456
DB_NAME=dnsmgr
# 表前缀：绑定彩虹 DNS（聚合 DNS 管理系统）现有数据时，填写其数据库实际使用的表前缀
DB_PREFIX=dnsmgr_

# 可选：内嵌 MySQL 的 root 密码（仅当启用 mysql 服务时生效）
MYSQL_ROOT_PASSWORD=123456

# ---- 反向代理 / CDN 场景（可选）----
# 位于 Nginx/CDN 之后时开启，使日志与限流使用 X-Forwarded-For 的真实客户端 IP
# DNSMGR_TRUST_PROXY=true
# 允许跨域调用 API 的来源（逗号分隔）；默认同源、不发送 CORS 头
# DNSMGR_ALLOWED_ORIGINS=https://dns.example.com
# 关闭 HSTS 响应头（默认开启）
# DNSMGR_HSTS=0
# 关闭登录/注册/安装接口限流（默认开启）
# DNSMGR_RATE_LIMIT=0
# 请求体大小上限（字节），默认 2097152（2MiB）
# DNSMGR_BODY_LIMIT=2097152