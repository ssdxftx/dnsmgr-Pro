# 应用对外端口
APP_PORT=8082

# 数据库类型：sqlite / mysql
# 未设置时：/app/data 有持久化挂载则默认 sqlite，否则默认 mysql
# DB_TYPE=sqlite
# SQLite 数据文件，默认 dnsmgr.sqlite（位于 DNSMGR_DATA_DIR）
# DB_FILE=dnsmgr.sqlite
# 无法读取容器挂载信息时，可显式声明数据目录为持久化（1/0）
# DNSMGR_DATA_PERSISTENT=1

# MySQL 连接（DB_TYPE=mysql 时使用；也可在安装页填写）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=dnsmgr
# 请填写强密码，切勿使用示例值
# DB_PASSWORD=change-me-strong-password
# DB_NAME=dnsmgr
# 表前缀：绑定彩虹 DNS（聚合 DNS 管理系统）现有数据时，填写其数据库实际使用的表前缀
# DB_PREFIX=dnsmgr_

# 可选：内嵌 MySQL 的 root 密码（仅当启用 mysql 服务时生效，必须设置强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# ---- 反向代理 / CDN 场景（可选）----
# 位于 Nginx/CDN 之后时开启，使日志与限流使用 X-Forwarded-For 的真实客户端 IP
# DNSMGR_TRUST_PROXY=true
# 允许跨域调用 API 的来源（逗号分隔）；默认同源、不发送 CORS 头
# DNSMGR_ALLOWED_ORIGINS=https://dns.example.com
# 关闭 HSTS 响应头（默认开启）
# DNSMGR_HSTS=0
# 关闭 CDN 缓存分层优化（默认开启）。开启时源站会分别下发 Cache-Control（浏览器）
# 与 CDN-Cache-Control / Surrogate-Control / Edge-Control / X-Accel-Expires（CDN 边缘）策略，
# 显著提升 CDN 缓存率，详见 deploy/CDN-CACHE.md
# DNSMGR_CDN_CACHE=0
# 关闭登录/注册/安装接口限流（默认开启）
# DNSMGR_RATE_LIMIT=0
# 请求体大小上限（字节），默认 2097152（2MiB）
# DNSMGR_BODY_LIMIT=2097152
# 覆盖 Cloudflare API 基址（仅本地联调/自建代理用，默认官方 https://api.cloudflare.com/client/v4）
# DNSMGR_CF_API_BASE=https://api.cloudflare.com/client/v4
# ---- 备份保留策略（可选）----
# 手动备份保留数量与天数（整站按站点、个人按用户分别计算）
# DNSMGR_BACKUP_KEEP_COUNT=10
# DNSMGR_BACKUP_KEEP_DAYS=30
# 恢复前自动快照保留数量与天数（保留最近的快照用于回滚）
# DNSMGR_PRE_RESTORE_KEEP_COUNT=5
# DNSMGR_PRE_RESTORE_KEEP_DAYS=14

# ---- 安全加固（可选）----
# 由外部托管的整站备份密钥（32 字节 Base64URL，可用 `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` 生成）。
# 设置后密钥不再从数据库读取，仅数据库泄露无法解密备份；此时不可在页面轮换密钥。
# DNSMGR_BACKUP_KEY=
# 部署任务自定义命令白名单（逗号分隔的前缀）。仅在 DNSMGR_ALLOW_DEPLOY_CMD=1 时生效，
# 未配置则允许任意命令，配置后只允许以指定前缀开头的命令。
# DNSMGR_DEPLOY_CMD_ALLOWLIST=systemctl reload nginx,docker restart
# 允许部署时关闭证书校验（FTP 自签名 / K8s 自签名集群）。默认禁止。
# DNSMGR_ALLOW_INSECURE_DEPLOY=1
# 容灾监控单轮并发任务数（默认 3，范围 1-8）
# DNSMGR_MONITOR_CONCURRENCY=3
# 前端开发/预览额外放行的 Host（逗号分隔），例如临时隧道域名
# VITE_ALLOWED_HOSTS=.trycloudflare.com
